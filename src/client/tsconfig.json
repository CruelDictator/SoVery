{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "jsx": "react-jsx",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "types": [
            "node",
            "jest",
            "react",
            "react-dom"
        ],
        "composite": true
    },
    "include": [
        ".",
        "../../types/**/*.ts",
        "../../types/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build",
        "coverage"
    ]
}