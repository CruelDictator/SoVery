{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@react-node-boilerplate/*": [
                "src/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist",
        "build",
        ".nx",
        "coverage"
    ],
    "references": [
        {
            "path": "./src/client"
        }
    ]
}