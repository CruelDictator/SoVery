{
    "extends": "@nrwl/workspace/presets/npm.json",
    "npmScope": "react-node-boilerplate",
    "affected": {
        "defaultBase": "main",
        "base": "main"
    },
    "tasksRunnerOptions": {
        "default": {
            "runner": "@nrwl/nx-cloud",
            "options": {
                "cacheableOperations": [
                    "build",
                    "test",
                    "lint",
                    "dev",
                    "type-check",
                    "start",
                    "seed"
                ],
                "accessToken": "YOUR_NX_CLOUD_TOKEN",
                "canTrackAnalytics": false,
                "showUsageWarnings": true,
                "parallel": 3,
                "cacheDirectory": ".nx-cache"
            }
        }
    },
    "targetDefaults": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "production",
                "^production"
            ],
            "cache": true
        },
        "test": {
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/jest.preset.js"
            ],
            "cache": true,
            "outputs": [
                "{workspaceRoot}/coverage/{projectRoot}"
            ]
        },
        "lint": {
            "inputs": [
                "default",
                "{workspaceRoot}/.eslintrc.json"
            ],
            "cache": true
        },
        "dev": {
            "dependsOn": [
                "^build"
            ],
            "cache": false
        },
        "type-check": {
            "cache": true,
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/tsconfig.json"
            ]
        }
    },
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals"
        ],
        "production": [
            "default",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
            "!{projectRoot}/tsconfig.spec.json",
            "!{projectRoot}/.eslintrc.json",
            "!{projectRoot}/jest.config.[jt]s",
            "!{projectRoot}/**/*.test.ts",
            "!{projectRoot}/**/*.spec.ts",
            "!{projectRoot}/**/__tests__/**",
            "!{projectRoot}/**/__mocks__/**"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/tsconfig.json",
            "{workspaceRoot}/.eslintrc.json",
            "{workspaceRoot}/jest.preset.js"
        ]
    }
}